  "title": "Chicken Adobo",
  "picture": "/public/recipes/adobo.jpg",
  "prep_time": 10,
  "cook_time": 40,
  "description": "A classic Filipino dish of meat braised in soy sauce, vinegar, garlic, and spices, known for its rich, tangy flavor.",
  "ingredients": [
    {
      "quantity": 2,
      "unit": "lbs",
      "name": "chicken, cut into serving pieces"
    },
    {
      "quantity": 0.5,
      "unit": "cup",
      "name": "soy sauce"
    },
    {
      "quantity": 0.5,
      "unit": "cup",
      "name": "vinegar"
    },
    {
      "quantity": 1,
      "unit": "head",
      "name": "garlic, crushed"
    },
    {
      "quantity": 1,
      "unit": "teaspoon",
      "name": "whole peppercorns"
    },
    {
      "quantity": 3,
      "unit": "pieces",
      "name": "dried bay leaves"
    },
    {
      "quantity": 1,
      "unit": "tablespoon",
      "name": "brown sugar"
    },
    {
      "quantity": 1,
      "unit": "cup",
      "name": "water"
    },
    {
      "quantity": "to taste",
      "unit": "",
      "name": "salt"
    }
  ],
  "steps": [
    "Combine chicken, soy sauce, vinegar, garlic, peppercorns, and bay leaves in a pot.",
    "Let it marinate for at least 30 minutes (optional but recommended).",
    "Bring to a boil and simmer over low heat for 25 to 30 minutes.",
    "Add water as needed during simmering.",
    "Add brown sugar and stir well.",
    "Continue to simmer until chicken is fully cooked and sauce has thickened.",
    "Adjust salt to taste.",
    "Serve with rice. Enjoy!"
