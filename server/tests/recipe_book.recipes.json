  "title": "Beef Kaldereta",
  "picture": "/public/recipes/kaldereta.jpg",
  "prep_time": 20,
  "cook_time": 75,
  "description": "A flavorful tomato-based meat stew, usually beef or goat, cooked with liver spread, potatoes, and bell peppers.",
  "ingredients": [
    {
      "quantity": 2,
      "unit": "lbs",
      "name": "beef chuck, cubed"
    },
    {
      "quantity": 1,
      "unit": "cup",
      "name": "tomato sauce"
    },
    {
      "quantity": 0.25,
      "unit": "cup",
      "name": "liver spread"
    },
    {
      "quantity": 0.5,
      "unit": "cup",
      "name": "grated cheese"
    },
    {
      "quantity": 1,
      "unit": "cup",
      "name": "beef broth or water"
    },
    {
      "quantity": 2,
      "unit": "medium",
      "name": "potatoes, cubed"
    },
    {
      "quantity": 1,
      "unit": "medium",
      "name": "carrot, sliced"
    },
    {
      "quantity": 1,
      "unit": "",
      "name": "red bell pepper, sliced"
    },
    {
      "quantity": 1,
      "unit": "",
      "name": "green bell pepper, sliced"
    },
    {
      "quantity": 1,
      "unit": "",
      "name": "onion, chopped"
    },
    {
      "quantity": 4,
      "unit": "cloves",
      "name": "garlic, minced"
    },
    {
      "quantity": 2,
      "unit": "tablespoons",
      "name": "cooking oil"
    },
    {
      "quantity": "to taste",
      "unit": "",
      "name": "salt and pepper"
    }
  ],
  "steps": [
    "Heat oil in a pot and sauté garlic and onion until fragrant.",
    "Add beef cubes and cook until browned.",
    "Pour in tomato sauce and broth. Cover and simmer for 1 hour or until beef is tender.",
    "Add liver spread and cheese. Stir until well blended.",
    "Add potatoes and carrots. Cook until vegetables are tender.",
    "Add bell peppers and cook for 5 more minutes.",
    "Season with salt and pepper to taste.",
    "Serve hot with rice."
  ],
  "datetime_added": "2023-10-06T12:00:00Z",
  "uploader": "jRizz1230"
